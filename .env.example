# Campus360 Database Connection (PostgreSQL)
# When running local embedded postgres via `npm run db:start`, use port 5433:
DATABASE_URL="postgresql://postgres:password@localhost:5433/campus360?schema=public"

# AI Provider API Keys
# Optional: Campus360 includes an offline heuristic NLP extraction engine as a fallback.
# Provide GROQ_API_KEY for cloud LLM inference:
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Security Session Secret
JWT_SECRET="campus360-jwt-secret-key-enterprise-2026-v1"

# Simulated Webhook Service Gateway
SIMULATED_WEBHOOK_URL="https://api.campus360.internal/v1/notifications/webhook"

# App Port
PORT=3000
